---
import {
  DEPT_SHAPES, RIVIERES, CITY_POINTS, VIEWBOX, REGION_OUTLINE, VOISINS, URBAIN, ECHELLE,
  METRES_PAR_UNITE,
} from '~/data/carte';
import { DEPT_BY_SLUG } from '~/data/departements';
import { VILLES_BY_DEPT } from '~/data/villes';

interface Props {
  /** Département mis en avant (page départementale ou communale). */
  active?: string;
  /** Hauteur réduite pour les intégrations secondaires. */
  compact?: boolean;
  id?: string;
}
const { active, compact = false, id = 'carte-idf' } = Astro.props;

const panelData = DEPT_SHAPES.map((s) => {
  const d = DEPT_BY_SLUG[s.slug];
  return {
    slug: s.slug,
    code: s.code,
    name: s.name,
    prefecture: d?.prefecture ?? '',
    villes: (VILLES_BY_DEPT[s.slug] ?? []).map((v) => ({ name: v.name, href: `/traitement-xylophages-${v.slug}` })),
  };
});
---
<div class={`map ${compact ? 'map--compact' : ''}`} id={id} data-active={active ?? ''}>
  <div class="map__stage">
    <svg
      class="map__svg"
      viewBox={`${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.w} ${VIEWBOX.h}`}
      role="img"
      aria-labelledby={`${id}-t ${id}-d`}
      data-vb={`${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.w} ${VIEWBOX.h}`}
    >
      <title id={`${id}-t`}>Carte des zones d’intervention en Île-de-France</title>
      <desc id={`${id}-d`}>
        Les huit départements d’Île-de-France sont représentés et cliquables, replacés
        parmi les départements limitrophes, la tache urbaine de l’agglomération et les
        principaux cours d’eau. La liste équivalente est disponible sous la carte pour
        une consultation sans interaction.
      </desc>

      <defs>
        <filter id={`${id}-sh`} x="-12%" y="-12%" width="124%" height="124%">
          <feDropShadow dx="0" dy="6" stdDeviation="9" flood-color="#1E2B24" flood-opacity="0.13" />
        </filter>
        <pattern id={`${id}-grain`} width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(28)">
          <line x1="0" y1="0" x2="0" y2="9" stroke="#3A5344" stroke-width="0.7" opacity="0.09" />
        </pattern>
      </defs>

      <g class="map__pan">
        {/* Départements limitrophes : contexte seul, ni cliquables ni desservis.
            Sans eux la région serait découpée sur un fond vide. */}
        <g class="map__around" aria-hidden="true">
          {VOISINS.map((v) => <path d={v.d} />)}
        </g>

        {/* Fond continu de la région : évite toute discontinuité entre les tracés. */}
        <path d={REGION_OUTLINE} class="map__region" filter={`url(#${id}-sh)`} />

        {/* Départements cliquables */}
        {DEPT_SHAPES.map((s) => (
          <a
            href={`/zones-intervention/${s.slug}`}
            class="map__dept"
            data-slug={s.slug}
            aria-label={`Insectes xylophages ${DEPT_BY_SLUG[s.slug]?.inName ?? s.name} (${s.code})`}
          >
            <path d={s.d} class="map__shape" />
            <path d={s.d} class="map__texture" fill={`url(#${id}-grain)`} />
          </a>
        ))}

        {/* Tache urbaine. Posée au-dessus des remplissages pour se lire aussi
            bien sur la région que sur les départements limitrophes. */}
        <path d={URBAIN} class="map__urban" aria-hidden="true" />

        {/* Repères hydrographiques */}
        <g class="map__rivers" aria-hidden="true">
          {RIVIERES.map((r) => <path d={r.d} />)}
        </g>

        {/* Noms des départements limitrophes, en retrait */}
        <g class="map__aroundnames" aria-hidden="true">
          {VOISINS.filter((v) => v.labelX !== undefined).map((v) => (
            <text x={v.labelX} y={v.labelY}>{v.name}</text>
          ))}
        </g>

        {/* Étiquettes de départements */}
        <g class="map__labels" aria-hidden="true">
          {DEPT_SHAPES.map((s) =>
            s.chip ? (
              <g class="map__chip" data-slug={s.slug}>
                <circle cx={s.labelX} cy={s.labelY} r="15" />
                <text x={s.labelX} y={s.labelY}>{s.code}</text>
              </g>
            ) : (
              <g class="map__name" data-slug={s.slug}>
                <text x={s.labelX} y={s.labelY}>{s.name}</text>
                <text x={s.labelX} y={s.labelY} class="map__code">{s.code}</text>
              </g>
            ),
          )}
        </g>

        {/* Communes disposant d’une page dédiée */}
        <g class="map__cities">
          {CITY_POINTS.map((c) => (
            <a
              href={`/traitement-xylophages-${c.slug}`}
              class:list={['map__city', c.always && 'is-always']}
              data-dept={c.dept}
              aria-label={`Traitement des insectes xylophages à ${c.name}`}
            >
              <circle cx={c.x} cy={c.y} r="11" class="map__hit" />
              <circle cx={c.x} cy={c.y} r="4" class="map__dot" />
              <text
                x={c.x}
                y={c.y}
                dy={c.dy ?? -9}
                dx={c.anchor === 'start' ? 8 : c.anchor === 'end' ? -8 : 0}
                text-anchor={c.anchor ?? 'middle'}
              >{c.name}</text>
            </a>
          ))}
        </g>
      </g>
    </svg>

    <div class="map__zoom" role="group" aria-label="Zoom de la carte">
      <button type="button" data-z="in" aria-label="Zoomer">+</button>
      <button type="button" data-z="out" aria-label="Dézoomer">−</button>
      <button type="button" data-z="reset" aria-label="Réinitialiser la vue">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.5 8A5.5 5.5 0 1 1 8 2.5c1.9 0 3.5.9 4.6 2.4M13 2v3h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    {/* Repères de carte : le nord et l'échelle. La barre est exprimée en
        pourcentage de la largeur, donc juste quel que soit l'écran ; le script
        la recalcule à chaque niveau d'agrandissement. */}
    <div class="map__north" aria-hidden="true">
      <svg viewBox="0 0 16 22" width="12" height="17">
        <path d="M8 1.5 L12.4 20 L8 16.4 L3.6 20 Z" fill="currentColor" />
      </svg>
      <span>N</span>
    </div>

    <div class="map__scale" data-mpu={METRES_PAR_UNITE}>
      <span class="map__scaleval">{ECHELLE.km} km</span>
      {/* La barre est dessinée dans un SVG large de 100 % de la scène, étiré
          sans conserver les proportions : une longueur exprimée en unités de
          la fenêtre y occupe donc exactement la même fraction que sur la
          carte. L'échelle est ainsi juste sur tout écran, sans style en
          ligne ni JavaScript. */}
      <svg
        class="map__scalebar"
        viewBox={`0 0 ${VIEWBOX.w} 100`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <rect x="0" y="0" width={ECHELLE.unites} height="100" />
      </svg>
    </div>

    <p class="map__hint">Touchez un département · pincez pour zoomer</p>
    <p class="map__credit">Contours : IGN Admin Express — Licence ouverte (Etalab)</p>
  </div>

  <aside class="map__panel" aria-live="polite">
    <div class="map__panel-in" data-state="idle">
      <p class="map__eyebrow">Zones d’intervention</p>
      <h3 class="map__ptitle">Île-de-France</h3>
      <p class="map__ptext">
        Nous intervenons dans les huit départements de la région pour le diagnostic
        et le traitement des insectes xylophages dans les bâtiments et les structures bois.
        Sélectionnez un département pour afficher le détail.
      </p>
      <div class="map__plinks"></div>
      <a href="/zones-intervention" class="btn btn--ghost btn--sm map__pcta">Voir toutes les zones</a>
    </div>
  </aside>

  {/* Équivalent textuel : indexable et utilisable sans JavaScript */}
  <nav class="map__list" aria-label="Départements desservis">
    {panelData.map((d) => (
      <a href={`/zones-intervention/${d.slug}`} class="map__listitem" data-slug={d.slug}>
        <span class="map__listcode">{d.code}</span>
        <span class="map__listname">{d.name}</span>
      </a>
    ))}
  </nav>

  <script type="application/json" class="map__data" set:html={JSON.stringify(panelData)} is:inline />
</div>

<style>
  .map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    grid-template-areas: 'stage panel' 'list list';
    gap: 1.25rem;
    align-items: start;
  }
  .map__stage {
    grid-area: stage; position: relative;
    background: linear-gradient(170deg, #F6F3EB 0%, #EFEBE0 100%);
    border: 1px solid var(--c-border); border-radius: var(--r-xl);
    overflow: hidden; touch-action: pan-y;
  }
  .map__svg { width: 100%; height: auto; display: block; aspect-ratio: 1000 / 880; cursor: grab; }
  /* Sur les pages secondaires la carte reste un repère, pas la pièce maîtresse :
     on borne sa largeur au lieu de recadrer son format, qui doit rester celui
     de la boîte englobante réelle de la région (1000 x 880). */
  .map--compact { max-width: 60rem; margin-inline: auto; }
  .map__svg.is-drag { cursor: grabbing; }

  /* --z porte le facteur de zoom courant, mis à jour par le script.
     Diviser par --z conserve aux traits et aux étiquettes une taille
     constante à l'écran quel que soit le niveau d'agrandissement : c'est
     ainsi que se comporte une carte, et cela rend le zoom réellement utile. */
  .map { --z: 1; }
  .map__region { fill: var(--sauge-300); }

  /* Contexte territorial : lisible mais nettement en retrait, pour qu'aucun
     département limitrophe ne puisse passer pour une zone desservie. */
  .map__around path {
    fill: #E4DFD2; stroke: #D3CCBB; stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .map__aroundnames text {
    font-family: var(--f-body); font-size: calc(15px / var(--z));
    font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    fill: #A79C88; text-anchor: middle; dominant-baseline: central;
    pointer-events: none;
  }
  /* Bâti continu, en transparence : il assombrit la région comme le pourtour
     sans masquer la couleur du département qu'il recouvre.
     Sa géométrie est levée au 10 millionième : juste pour situer
     l'agglomération, beaucoup trop grossière pour une vue à quelques
     kilomètres, où elle ne serait plus qu'un aplat de polygones anguleux.
     L'opacité décroît donc avec l'agrandissement, jusqu'à l'effacer. */
  .map__urban {
    fill: #8C7F66; opacity: calc(.28 / var(--z)); pointer-events: none;
    transition: opacity .2s ease;
  }

  .map__shape {
    fill: var(--sauge-300); stroke: #FBF8F1; stroke-width: 2.4; stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: fill .2s ease;
  }
  .map__texture { pointer-events: none; }
  .map__dept { cursor: pointer; outline: none; }
  .map__dept:hover .map__shape,
  .map__dept:focus-visible .map__shape { fill: var(--sauge-500); }
  .map__dept.is-active .map__shape { fill: var(--sauge-600); }
  .map__dept.is-current .map__shape { fill: var(--sauge-700); }
  .map__dept:focus-visible .map__shape { stroke: var(--cuivre-500); stroke-width: 3.5; }

  .map__rivers path { fill: none; stroke: #8FA8C4; stroke-width: 2.2; stroke-linecap: round; opacity: .5; vector-effect: non-scaling-stroke; }

  .map__labels { pointer-events: none; }
  .map__name text {
    font-family: var(--f-title); font-size: calc(21px / var(--z)); font-weight: 600; fill: #22301F;
    text-anchor: middle; paint-order: stroke; stroke: rgba(251,248,241,.8);
    stroke-width: 3.5; vector-effect: non-scaling-stroke;
  }
  .map__name .map__code {
    font-family: var(--f-body); font-size: calc(12px / var(--z)); font-weight: 600;
    fill: var(--cuivre-600); letter-spacing: .1em;
    translate: 0 calc(19px / var(--z));
  }
  .map__chip circle {
    r: calc(15px / var(--z)); fill: #FBF8F1; stroke: var(--sauge-600);
    stroke-width: 2; vector-effect: non-scaling-stroke;
  }
  .map__chip text {
    font-family: var(--f-body); font-size: calc(13px / var(--z)); font-weight: 700;
    fill: var(--sauge-800); text-anchor: middle;
    /* Centrage vertical indépendant de la taille de police : un décalage en
       unités SVG se désaligne dès que la carte est agrandie. */
    dominant-baseline: central;
  }

  .map__city { cursor: pointer; }
  .map__hit { r: calc(11px / var(--z)); fill: transparent; }
  .map__dot {
    r: calc(4px / var(--z)); fill: var(--cuivre-500); stroke: #FBF8F1;
    stroke-width: 2; vector-effect: non-scaling-stroke; transition: r .15s ease;
  }
  .map__city text {
    font-family: var(--f-body); font-size: calc(13px / var(--z)); font-weight: 600; fill: #3D372E;
    paint-order: stroke; stroke: rgba(251,248,241,.92); stroke-width: 3.2;
    vector-effect: non-scaling-stroke;
    opacity: 0; transition: opacity .15s ease; pointer-events: none;
    translate: calc(var(--dx, 0) * 1px / var(--z)) calc(var(--dy, -9) * 1px / var(--z));
  }
  .map__city.is-always text { opacity: 1; }
  .map.is-zoomed .map__city text { opacity: 1; }
  .map__city:hover text, .map__city:focus-visible text { opacity: 1; }
  .map__city:hover .map__dot, .map__city:focus-visible .map__dot { r: calc(6px / var(--z)); }
  .map__cities.is-dimmed .map__city:not(.is-on) { opacity: .28; }
  .map__cities.is-dimmed .map__city.is-on text { opacity: 1; }

  .map__zoom {
    position: absolute; right: .8rem; top: .8rem; display: flex; flex-direction: column; gap: .3rem;
  }
  .map__zoom button {
    width: 34px; height: 34px; border-radius: var(--r-sm);
    background: rgba(255,255,255,.94); border: 1px solid var(--c-border);
    color: var(--sauge-800); font-size: 1.05rem; line-height: 1;
    display: grid; place-items: center; box-shadow: var(--sh-xs);
  }
  .map__zoom button:hover { background: #fff; border-color: var(--sauge-400); }
  .map__hint {
    position: absolute; left: .9rem; bottom: .75rem; margin: 0;
    font-size: .7rem; color: var(--gris-500); background: rgba(255,255,255,.8);
    padding: .25rem .6rem; border-radius: var(--r-pill);
  }

  /* Attribution des données géographiques : requise par la Licence ouverte. */
  /* Rose des vents et échelle : les deux repères qui font qu'une carte se lit
     comme une carte et non comme un schéma. */
  .map__north {
    position: absolute; left: .9rem; top: .85rem;
    display: flex; flex-direction: column; align-items: center; gap: .05rem;
    color: var(--sauge-700); opacity: .65; pointer-events: none;
  }
  .map__north span {
    font-family: var(--f-body); font-size: .58rem; font-weight: 700;
    letter-spacing: .06em; line-height: 1;
  }

  .map__scale {
    position: absolute; left: 0; right: 0; bottom: 2.55rem;
    pointer-events: none;
  }
  .map__scaleval {
    display: block; margin-left: .9rem; margin-bottom: .16rem;
    font-family: var(--f-body); font-size: .6rem; font-weight: 600;
    letter-spacing: .02em; color: var(--gris-600);
  }
  .map__scalebar {
    display: block; width: 100%; height: 5px;
    margin-left: .9rem; overflow: visible;
  }
  .map__scalebar rect { fill: var(--sauge-800); }

  .map__credit {
    position: absolute; right: .75rem; bottom: .6rem;
    margin: 0; font-size: .62rem; line-height: 1.3;
    color: var(--gris-500); letter-spacing: .01em;
    background: rgba(246, 243, 235, .82);
    padding: .2rem .45rem; border-radius: var(--r-sm);
    pointer-events: none; max-width: 60%; text-align: right;
  }

  .map__panel { grid-area: panel; }
  .map__panel-in {
    background: var(--c-surface); border: 1px solid var(--c-border);
    border-radius: var(--r-lg); padding: 1.5rem 1.4rem; box-shadow: var(--sh-xs);
    position: sticky; top: 100px;
  }
  :global(.map__eyebrow) {
    font-size: .64rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--cuivre-500); margin-bottom: .5rem;
  }
  :global(.map__ptitle) { font-size: 1.5rem; margin-bottom: .6rem; }
  :global(.map__ptext) { font-size: .85rem; color: var(--c-text-soft); line-height: 1.6; }
  :global(.map__plinks) { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .4rem; }
  :global(.map__plinks a) {
    font-size: .74rem; font-weight: 600; text-decoration: none;
    background: var(--sauge-50); color: var(--sauge-800);
    padding: .3rem .65rem; border-radius: var(--r-pill); border: 1px solid var(--sauge-200);
  }
  :global(.map__plinks a:hover) { background: var(--sauge-100); }
  :global(.map__pcta) { margin-top: 1.25rem; }

  .map__list {
    grid-area: list; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .5rem;
  }
  .map__listitem {
    display: flex; align-items: center; gap: .6rem; text-decoration: none;
    padding: .62rem .8rem; border: 1px solid var(--c-border); border-radius: var(--r-md);
    background: var(--c-surface); transition: border-color .16s ease, background-color .16s ease;
  }
  .map__listitem:hover, .map__listitem.is-active { border-color: var(--sauge-400); background: var(--sauge-50); }
  .map__listcode {
    font-family: var(--f-title); font-size: .78rem; font-weight: 700; color: var(--cuivre-600);
    background: var(--cuivre-100); border-radius: var(--r-xs); padding: .1rem .35rem;
  }
  .map__listname { font-size: .82rem; font-weight: 600; color: var(--sauge-800); }

  @media (max-width: 900px) {
    .map { grid-template-columns: 1fr; grid-template-areas: 'stage' 'panel' 'list'; }
    .map__panel-in { position: static; }
    /* La carte est réduite d’environ deux tiers : les étiquettes sont agrandies
       en proportion pour rester lisibles. */
    .map__name text { font-size: calc(42px / var(--z)); stroke-width: 6; }
    .map__aroundnames text { font-size: calc(26px / var(--z)); }
    .map__name .map__code { font-size: calc(24px / var(--z)); translate: 0 calc(34px / var(--z)); }
    .map__chip circle { r: calc(26px / var(--z)); stroke-width: 3.5; }
    .map__chip text { font-size: calc(24px / var(--z)); }
    .map__city .map__hit { r: calc(18px / var(--z)); }
    .map__city .map__dot { r: calc(7px / var(--z)); stroke-width: 3; }
    .map__city text { font-size: calc(28px / var(--z)); stroke-width: 6; }
    .map__city:not(.is-always) text { display: none; }
    /* Agrandir la carte sert précisément à lire le cœur dense de l'agglomération :
       une fois zoomé, les étiquettes masquées faute de place réapparaissent. */
    .map.is-zoomed .map__city text { display: block; opacity: 1; }
    .map__rivers path { stroke-width: 3.5; }
    .map__shape { stroke-width: 4; }
    .map__hint { left: 50%; transform: translateX(-50%); bottom: 2.6rem; font-size: .68rem; white-space: nowrap; }
    /* L'indication passe au centre : le crédit descend pour ne pas la recouvrir. */
    .map__credit { right: auto; left: 50%; transform: translateX(-50%); bottom: .5rem; max-width: 92%; text-align: center; }
    /* Le bas de la scène est déjà pris : l'échelle passe en haut, à l'opposé
       des boutons de zoom, et la rose des vents s'efface. */
    .map__north { display: none; }
    .map__scale { top: .75rem; bottom: auto; }
  }

  /* Sur un écran de téléphone, les noms de communes agrandis recouvrent les noms
     de départements. Le nom du département prime : on masque les étiquettes de
     communes tant que la carte n'est pas agrandie, en conservant leurs points,
     qui restent activables et annoncés par leur `aria-label`. Les communes sont
     par ailleurs listées en toutes lettres sous la carte et dans le panneau. */
  @media (max-width: 620px) {
    .map__city text { display: none; }
    .map.is-zoomed .map__city text { display: block; opacity: 1; }
  }
</style>

<script>
  type PanelDept = { slug: string; code: string; name: string; prefecture: string; villes: { name: string; href: string }[] };

  const init = (root: HTMLElement) => {
    const svg = root.querySelector<SVGSVGElement>('.map__svg');
    const panel = root.querySelector<HTMLElement>('.map__panel-in');
    const dataEl = root.querySelector<HTMLScriptElement>('.map__data');
    if (!svg || !panel || !dataEl) return;

    const depts: PanelDept[] = JSON.parse(dataEl.textContent || '[]');
    const bySlug = new Map(depts.map((d) => [d.slug, d]));
    const base = (svg.dataset.vb || '0 0 1000 880').split(' ').map(Number) as [number, number, number, number];
    const cities = root.querySelector<SVGGElement>('.map__cities');

    /* Barre d'échelle. Son SVG ne suit pas l'agrandissement de la carte :
       c'est le script qui allonge la barre et choisit une valeur ronde, comme
       le ferait une carte en ligne. */
    const echelle = root.querySelector<HTMLElement>('.map__scale');
    const barre = root.querySelector<SVGRectElement>('.map__scalebar rect');
    const valeur = root.querySelector<HTMLElement>('.map__scaleval');
    const metresParUnite = Number(echelle?.dataset.mpu ?? 0);
    const PALIERS = [1, 2, 5, 10, 20, 25, 50, 100, 200];
    const majEchelle = (z: number) => {
      if (!barre || !valeur || !metresParUnite) return;
      // On vise une barre occupant environ 12 % de la largeur de la scène.
      const vise = ((120 / z) * metresParUnite) / 1000;
      const km = PALIERS.reduce((m, v) => (Math.abs(v - vise) < Math.abs(m - vise) ? v : m), PALIERS[0]);
      barre.setAttribute('width', String((((km * 1000) / metresParUnite) * z).toFixed(1)));
      valeur.textContent = `${km} km`;
    };

    let [vx, vy, vw, vh] = base;
    const apply = () => {
      svg.setAttribute('viewBox', `${vx} ${vy} ${vw} ${vh}`);
      /* Facteur de zoom : les tailles exprimées en unités SVG sont divisées
         par cette valeur pour rester constantes à l'écran. */
      const z = base[2] / vw;
      root.style.setProperty('--z', String(z));
      /* Une fois la carte agrandie, la place revient : les étiquettes de communes
         masquées sur petit écran peuvent réapparaître. */
      root.classList.toggle('is-zoomed', z > 1.4);
      majEchelle(z);
    };

    const clamp = () => {
      /* Jusqu'à huit fois : les étiquettes ne grossissant plus, l'agrandissement
         sert réellement à lire la petite couronne. */
      const minW = base[2] * 0.125;
      const maxW = base[2] * 1.25;
      vw = Math.min(maxW, Math.max(minW, vw));
      vh = (vw / base[2]) * base[3];
      vx = Math.min(base[0] + base[2] - vw * 0.35, Math.max(base[0] - vw * 0.65, vx));
      vy = Math.min(base[1] + base[3] - vh * 0.35, Math.max(base[1] - vh * 0.65, vy));
    };

    const zoomAt = (factor: number, cx = vx + vw / 2, cy = vy + vh / 2) => {
      const nw = vw * factor;
      const ratio = nw / vw;
      vx = cx - (cx - vx) * ratio;
      vy = cy - (cy - vy) * ratio;
      vw = nw;
      clamp();
      apply();
    };

    root.querySelectorAll<HTMLButtonElement>('.map__zoom button').forEach((b) => {
      b.addEventListener('click', () => {
        const mode = b.dataset.z;
        if (mode === 'in') zoomAt(0.72);
        else if (mode === 'out') zoomAt(1 / 0.72);
        else { [vx, vy, vw, vh] = base; apply(); }
      });
    });

    svg.addEventListener('wheel', (e) => {
      e.preventDefault();
      const pt = toSvg(e.clientX, e.clientY);
      zoomAt(e.deltaY > 0 ? 1.12 : 0.89, pt.x, pt.y);
    }, { passive: false });

    const toSvg = (clientX: number, clientY: number) => {
      const r = svg.getBoundingClientRect();
      return { x: vx + ((clientX - r.left) / r.width) * vw, y: vy + ((clientY - r.top) / r.height) * vh };
    };

    /* --- Déplacement à la souris et au doigt --- */
    let dragging = false, moved = 0, last = { x: 0, y: 0 };
    const down = (x: number, y: number) => { dragging = true; moved = 0; last = { x, y }; svg.classList.add('is-drag'); };
    const move = (x: number, y: number) => {
      if (!dragging) return;
      const r = svg.getBoundingClientRect();
      const dx = ((x - last.x) / r.width) * vw;
      const dy = ((y - last.y) / r.height) * vh;
      moved += Math.abs(dx) + Math.abs(dy);
      vx -= dx; vy -= dy; last = { x, y };
      clamp(); apply();
    };
    const up = () => { dragging = false; svg.classList.remove('is-drag'); };

    svg.addEventListener('pointerdown', (e) => { if (e.button === 0) down(e.clientX, e.clientY); });
    addEventListener('pointermove', (e) => move(e.clientX, e.clientY));
    addEventListener('pointerup', up);
    addEventListener('pointercancel', up);

    let pinch = 0;
    svg.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) {
        pinch = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      }
    }, { passive: true });
    svg.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2 && pinch) {
        e.preventDefault();
        const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        const mid = toSvg((e.touches[0].clientX + e.touches[1].clientX) / 2, (e.touches[0].clientY + e.touches[1].clientY) / 2);
        zoomAt(pinch / d, mid.x, mid.y);
        pinch = d;
      }
    }, { passive: false });
    svg.addEventListener('touchend', () => { pinch = 0; }, { passive: true });

    /* --- Panneau d’information --- */
    const listItems = root.querySelectorAll<HTMLElement>('.map__listitem');
    const deptNodes = root.querySelectorAll<SVGAElement>('.map__dept');

    const select = (slug: string) => {
      const d = bySlug.get(slug);
      if (!d) return;
      deptNodes.forEach((n) => n.classList.toggle('is-active', n.dataset.slug === slug));
      listItems.forEach((n) => n.classList.toggle('is-active', n.dataset.slug === slug));
      cities?.classList.add('is-dimmed');
      cities?.querySelectorAll<SVGAElement>('.map__city').forEach((c) => {
        c.classList.toggle('is-on', c.dataset.dept === slug);
      });
      /* Le panneau est reconstruit avec les interfaces du DOM plutôt que par
         concaténation de HTML : pas d'échappement à gérer, et le résultat
         reste valide quelles que soient les données. */
      const el = <K extends keyof HTMLElementTagNameMap>(
        balise: K, classe: string, texte?: string,
      ): HTMLElementTagNameMap[K] => {
        const n = document.createElement(balise);
        n.className = classe;
        if (texte !== undefined) n.textContent = texte;
        return n;
      };

      const origine = d.prefecture
        ? `, depuis ${d.name === 'Paris' ? 'Paris' : 'la préfecture de ' + d.prefecture} jusqu’aux communes les plus éloignées`
        : '';

      const contenu: HTMLElement[] = [
        el('p', 'map__eyebrow', `Département ${d.code}`),
        el('h3', 'map__ptitle', d.name),
        el('p', 'map__ptext',
          'Interventions pour le diagnostic et le traitement des insectes xylophages ' +
          `dans les bâtiments et structures bois${origine}.`),
      ];

      if (d.villes.length) {
        const liste = el('div', 'map__plinks');
        for (const v of d.villes) {
          const a = el('a', '');
          a.href = v.href;
          a.textContent = v.name;
          liste.append(a);
        }
        contenu.push(liste);
      }

      const cta = el('a', 'btn btn--primary btn--sm map__pcta',
        `Voir les interventions ${prep(d.name)}`);
      cta.href = `/zones-intervention/${d.slug}`;
      contenu.push(cta);

      panel.replaceChildren(...contenu);
      panel.dataset.state = 'dept';
    };

    const prep = (name: string) => {
      const map: Record<string, string> = {
        Paris: 'à Paris',
        'Seine-et-Marne': 'en Seine-et-Marne',
        Yvelines: 'dans les Yvelines',
        Essonne: 'en Essonne',
        'Hauts-de-Seine': 'dans les Hauts-de-Seine',
        'Seine-Saint-Denis': 'en Seine-Saint-Denis',
        'Val-de-Marne': 'dans le Val-de-Marne',
        "Val-d’Oise": "dans le Val-d’Oise",
      };
      return map[name] ?? `dans le ${name}`;
    };

    /* Sur un écran tactile, il n’y a pas de survol : une première pression
       sélectionne le département et affiche le panneau, la seconde navigue. */
    const tactile = matchMedia('(hover: none)').matches;
    let selectionne: string | null = null;

    deptNodes.forEach((node) => {
      const slug = node.dataset.slug!;
      node.addEventListener('pointerenter', () => { if (!tactile) select(slug); });
      node.addEventListener('focus', () => select(slug));
      node.addEventListener('click', (e) => {
        /* Un glissement de carte ne doit pas déclencher la navigation. */
        if (moved > 6) { e.preventDefault(); return; }
        if (tactile && selectionne !== slug) {
          e.preventDefault();
          selectionne = slug;
          select(slug);
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });
    listItems.forEach((node) => {
      node.addEventListener('pointerenter', () => select(node.dataset.slug!));
    });

    /* Département courant mis en évidence sur les pages locales. */
    const current = root.dataset.active;
    if (current) {
      selectionne = current;
      deptNodes.forEach((n) => n.classList.toggle('is-current', n.dataset.slug === current));
      select(current);
    }
  };

  const mount = () => document.querySelectorAll<HTMLElement>('.map').forEach(init);
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { init(en.target as HTMLElement); obs.unobserve(en.target); }
      });
    }, { rootMargin: '300px' });
    document.querySelectorAll<HTMLElement>('.map').forEach((el) => io.observe(el));
  } else {
    mount();
  }
</script>
