---
import { SITE } from '~/data/site';
interface Props {
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
  variant?: 'dark' | 'sage';
}
const {
  title = 'Un doute sur une charpente, une poutre ou un plancher ?',
  text = "Décrivez ce que vous observez. Nous vous indiquons ce qu'il est utile de vérifier, et nous organisons une visite si l'examen du bois sur place est nécessaire.",
  primary = { label: 'Demander un diagnostic', href: '/demander-un-diagnostic' },
  variant = 'dark',
} = Astro.props;
---
<section class={`ctaband ctaband--${variant} ${variant === 'dark' ? 'blueprint' : ''}`}>
  <div class="wrap ctaband__in">
    <div class="ctaband__txt">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="ctaband__act">
      <a href={primary.href} class={`btn ${variant === 'dark' ? 'btn--light' : 'btn--primary'}`}>{primary.label}</a>
      <a href={SITE.phoneHref} class={`btn ${variant === 'dark' ? 'btn--outline-light' : 'btn--ghost'}`}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5.2 2.2 6.6 5 5.3 6.5c.8 1.6 2.1 2.9 3.7 3.7L10.5 9l2.8 1.4v2.4c0 .6-.5 1-1.1 1C6.6 13.4 2.1 8.9 2 2.9c0-.6.4-1.1 1-1.1h2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
<style>
  .ctaband { padding-block: clamp(2.75rem, 2rem + 3.5vw, 4.75rem); }
  .ctaband--dark { background: var(--sauge-900); color: rgba(243,239,228,.78); }
  .ctaband--dark h2 { color: #F5F1E6; }
  .ctaband--sage { background: var(--sauge-50); border-block: 1px solid var(--sauge-200); }
  .ctaband__in { display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; justify-content: space-between; }
  .ctaband__txt { max-width: 56ch; }
  .ctaband__txt h2 { font-size: var(--t-h3); margin-bottom: .6rem; }
  .ctaband__txt p { font-size: var(--t-sm); line-height: 1.65; }
  .ctaband--sage .ctaband__txt p { color: var(--c-text-soft); }
  .ctaband__act { display: flex; flex-wrap: wrap; gap: .75rem; }
  @media (max-width: 720px) { .ctaband__act { width: 100%; } .ctaband__act .btn { flex: 1; min-width: 180px; } }
</style>
