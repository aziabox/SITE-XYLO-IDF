---
interface Props { variant?: 'dark' | 'light'; compact?: boolean; class?: string }
const { variant = 'dark', compact = false, class: cls = '' } = Astro.props;
---
<span class={`logo logo--${variant} ${cls}`} aria-hidden="false">
  <svg class="logo__mark" viewBox="0 0 40 40" width="38" height="38" role="img" aria-label="">
    <rect x="0.5" y="0.5" width="39" height="39" rx="11" fill="#3A5344" />
    {/* Cernes de croissance : section transversale d’une pièce de bois */}
    <g fill="none" stroke="#A4BFAD" stroke-width="1.3" stroke-linecap="round">
      <path d="M11 30.5a14 14 0 0 1 19.5-19.5" opacity=".55" />
      <path d="M14.5 31.5A11.5 11.5 0 0 1 31.5 14.5" opacity=".7" />
      <path d="M18.5 32.2A8 8 0 0 1 32.2 18.5" opacity=".85" />
    </g>
    <path d="M23 32.6A5 5 0 0 1 32.6 23" fill="none" stroke="#DBA684" stroke-width="1.6" stroke-linecap="round" />
    <circle cx="31.4" cy="31.4" r="1.9" fill="#9D5A33" />
  </svg>
  {!compact && (
    <span class="logo__text">
      <span class="logo__name">Xylo<span class="logo__name--light">Patrimoine</span></span>
      <span class="logo__base">Traitement du bois · Île-de-France</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .68rem; text-decoration: none; }
  .logo__mark { flex: none; border-radius: 11px; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name {
    font-family: var(--f-title); font-size: 1.22rem; font-weight: 640;
    letter-spacing: -0.02em; font-variation-settings: 'SOFT' 20, 'opsz' 24;
  }
  /* Les deux déclinaisons évitent un attribut style en ligne, incompatible
     avec une politique de sécurité de contenu stricte. */
  .logo--dark .logo__name  { color: #2C3E33; }
  .logo--dark .logo__base  { color: #716A5E; }
  .logo--light .logo__name { color: #F4F0E5; }
  .logo--light .logo__base { color: rgba(244, 240, 229, .62); }
  .logo__name--light { font-weight: 420; font-style: italic; }
  .logo__base {
    font-size: .625rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    margin-top: .18rem;
  }
  @media (max-width: 420px) { .logo__base { display: none; } .logo__name { font-size: 1.1rem; } }
</style>
