---
import { Picture } from 'astro:assets';

/**
 * Photographie du site, avec repli sur une illustration technique.
 *
 * Fonctionnement : déposez un fichier dans `src/assets/photos/` en respectant la
 * convention de nommage (voir le README de ce dossier), puis appelez ce composant
 * avec le nom du fichier. Astro génère alors automatiquement les formats AVIF et
 * WebP, plusieurs largeurs, et applique le chargement différé.
 *
 * Tant que la photographie n'a pas été fournie, le contenu passé en `slot`
 * — généralement un schéma SVG — est affiché à la place. Aucune image
 * d'illustration générique n'est utilisée : le site ne montre que des visuels
 * qui décrivent réellement ce dont il parle.
 */
interface Props {
  /** Nom du fichier dans src/assets/photos, extension comprise. */
  nom?: string;
  /** Texte alternatif décrivant ce que montre l'image, sans bourrage de mots-clés. */
  alt: string;
  /** Légende éditoriale affichée sous l'image. */
  legende?: string;
  /** Largeurs générées pour le srcset. */
  largeurs?: number[];
  sizes?: string;
  /** true pour la seule image au-dessus de la ligne de flottaison. */
  prioritaire?: boolean;
  class?: string;
}
const {
  nom,
  alt,
  legende,
  largeurs = [480, 768, 1024, 1440],
  sizes = '(max-width: 900px) 100vw, 640px',
  prioritaire = false,
  class: cls = '',
} = Astro.props;

const disponibles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const cle = nom ? `/src/assets/photos/${nom}` : null;
const image = cle ? disponibles[cle]?.default : undefined;
---
<figure class={`photo ${cls}`}>
  {image ? (
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={largeurs}
      sizes={sizes}
      alt={alt}
      loading={prioritaire ? 'eager' : 'lazy'}
      decoding={prioritaire ? 'sync' : 'async'}
      fetchpriority={prioritaire ? 'high' : 'auto'}
      class="photo__img"
    />
  ) : (
    <div class="photo__repli" role="img" aria-label={alt}>
      <slot />
    </div>
  )}
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  .photo { margin: 0; }
  .photo__img {
    width: 100%; height: auto; display: block;
    border-radius: var(--r-lg); background: var(--pierre-100);
  }
  .photo__repli { border-radius: var(--r-lg); overflow: hidden; }
  .photo figcaption {
    margin-top: .9rem; font-size: var(--t-xs); color: var(--c-text-muted);
    line-height: 1.55; max-width: 56ch;
  }
</style>
