---
/**
 * Schéma d’une ferme de charpente traditionnelle, avec repérage des points
 * que l’inspection examine en priorité. Dessin technique, non photographique.
 */
interface Props { annotated?: boolean; class?: string }
const { annotated = true, class: cls = '' } = Astro.props;
---
<svg class={`illus-charpente ${cls}`} viewBox="0 0 820 560" role="img"
     aria-label="Schéma d’une ferme de charpente : entrait, arbalétriers, poinçon, contrefiches et pannes, avec repérage des zones inspectées en priorité.">
  <defs>
    <pattern id="ch-grain" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
      <line x1="0" y1="0" x2="0" y2="7" stroke="#8A6F52" stroke-width="0.8" opacity="0.22" />
    </pattern>
    <linearGradient id="ch-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C8AE8B" /><stop offset="1" stop-color="#AD8F69" />
    </linearGradient>
  </defs>

  {/* Trame d’implantation */}
  <g stroke="#5D7E6A" stroke-width="0.6" opacity="0.16">
    {[...Array(9)].map((_, i) => <line x1={60 + i * 88} y1="60" x2={60 + i * 88} y2="470" />)}
    {[...Array(5)].map((_, i) => <line x1="60" y1={80 + i * 98} x2="764" y2={80 + i * 98} />)}
  </g>

  {/* Maçonnerie d’appui */}
  <g fill="#E0D7C6" stroke="#C6BAA4" stroke-width="1.4">
    <rect x="62" y="400" width="86" height="72" rx="2" />
    <rect x="672" y="400" width="86" height="72" rx="2" />
  </g>
  <g stroke="#C6BAA4" stroke-width="1" opacity=".8">
    <line x1="62" y1="424" x2="148" y2="424" /><line x1="62" y1="448" x2="148" y2="448" />
    <line x1="672" y1="424" x2="758" y2="424" /><line x1="672" y1="448" x2="758" y2="448" />
  </g>

  {/* Chevrons */}
  <g stroke="#8A6F52" stroke-width="3" stroke-linecap="round" opacity=".45">
    <line x1="96" y1="374" x2="410" y2="92" /><line x1="410" y1="92" x2="724" y2="374" />
  </g>

  {/* Pièces de la ferme */}
  <g stroke="#6E5740" stroke-width="2" stroke-linejoin="round">
    {/* Arbalétriers */}
    <path d="M104 392 L410 110 L426 128 L120 410 Z" fill="url(#ch-wood)" />
    <path d="M716 392 L410 110 L394 128 L700 410 Z" fill="url(#ch-wood)" />
    <path d="M104 392 L410 110 L426 128 L120 410 Z" fill="url(#ch-grain)" stroke="none" />
    <path d="M716 392 L410 110 L394 128 L700 410 Z" fill="url(#ch-grain)" stroke="none" />
    {/* Entrait */}
    <rect x="96" y="392" width="628" height="26" rx="2" fill="url(#ch-wood)" />
    <rect x="96" y="392" width="628" height="26" rx="2" fill="url(#ch-grain)" stroke="none" />
    {/* Poinçon */}
    <rect x="396" y="122" width="28" height="272" rx="2" fill="url(#ch-wood)" />
    <rect x="396" y="122" width="28" height="272" rx="2" fill="url(#ch-grain)" stroke="none" />
    {/* Contrefiches */}
    <path d="M400 330 L262 248 L274 230 L412 312 Z" fill="url(#ch-wood)" />
    <path d="M420 330 L558 248 L546 230 L408 312 Z" fill="url(#ch-wood)" />
  </g>

  {/* Pannes */}
  <g fill="#8A6F52" stroke="#5A4632" stroke-width="1.5">
    <rect x="252" y="228" width="26" height="22" rx="2" />
    <rect x="542" y="228" width="26" height="22" rx="2" />
    <rect x="397" y="96" width="26" height="22" rx="2" />
  </g>

  {annotated && (
    <g class="annot">
      {/* Point sensible 1 : about d’entrait sur maçonnerie */}
      <circle cx="120" cy="404" r="34" fill="none" stroke="#9D5A33" stroke-width="1.8" stroke-dasharray="5 4" />
      <line x1="120" y1="440" x2="120" y2="490" stroke="#9D5A33" stroke-width="1.3" />
      <text x="34" y="512" class="an">About d’entrait sur maçonnerie</text>
      <text x="34" y="532" class="an an--s">humidité possible, zone à sonder</text>

      {/* Point sensible 2 : pied de chevron */}
      <circle cx="700" cy="404" r="34" fill="none" stroke="#9D5A33" stroke-width="1.8" stroke-dasharray="5 4" />
      <line x1="700" y1="440" x2="700" y2="490" stroke="#9D5A33" stroke-width="1.3" />
      <text x="786" y="512" class="an" text-anchor="end">Pied de chevron et bois de rive</text>
      <text x="786" y="532" class="an an--s" text-anchor="end">infiltrations de couverture</text>

      {/* Point sensible 3 : assemblage en tête */}
      <circle cx="410" cy="122" r="30" fill="none" stroke="#9D5A33" stroke-width="1.8" stroke-dasharray="5 4" />
      <line x1="410" y1="92" x2="410" y2="62" stroke="#9D5A33" stroke-width="1.3" />
      <text x="410" y="54" class="an" text-anchor="middle">Assemblages en tête</text>

      {/* Légende des pièces */}
      <g class="lg">
        <text x="410" y="452" text-anchor="middle">Entrait</text>
        <text x="236" y="182" text-anchor="middle">Arbalétrier</text>
        <text x="444" y="246" text-anchor="start">Poinçon</text>
        <text x="600" y="200" text-anchor="start">Panne</text>
        <text x="286" y="352" text-anchor="middle">Contrefiche</text>
      </g>
    </g>
  )}
</svg>

<style>
  .illus-charpente { width: 100%; height: auto; }
  .an { font-family: var(--f-body); font-size: 13px; font-weight: 650; fill: #874A28; }
  .an--s { font-weight: 400; fill: #837C70; font-size: 12px; }
  .lg text { font-family: var(--f-body); font-size: 12px; fill: #635D53; letter-spacing: .04em; }
  @media (max-width: 640px) { .an, .an--s, .lg text { font-size: 15px; } }
</style>
