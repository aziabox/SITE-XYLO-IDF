  {/* ==================== BLOG ==================== */}
  {posts.length > 0 && (
    <section class="section section--warm" id="blog">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Ressources</p>
          <h2>Comprendre les insectes du bois</h2>
