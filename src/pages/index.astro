              <p class="ins__sci">{CATEGORIES[p.data.category].name} · {frDate(p.data.published)}</p>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="card__foot link-arrow">Lire l’article</span>
            </a>
          ))}
        </div>
        <p style="margin-top:1.75rem"><a href="/blog" class="link-arrow">Tous les articles</a></p>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

